document.write(`
                        <div style="background:#fff; color:#000; font-family: 'Courier New', Courier, monospace; height:100vh; padding:40px; box-sizing:border-box;">
                            <h1 style="font-size:3rem; margin-bottom:0;">${code}</h1>
                            <p style="font-size:1.2rem; margin-top:5px; border-bottom:1px solid #000; padding-bottom:10px;">${desc}</p>
                            <div style="margin-top:30px; line-height:1.6; color: #333;">
                                <p>> DEVICE_ID: UID-${Math.floor(Math.random()*999999)}</p>
                                <p>> SYSTEM_LOG: ${isTimeout ? 'SESSION_EXPIRED_BY_SERVER' : 'SYSTEM_DENIED_ACCESS'}</p>
                                <p>> REMOTE_ADDR: ${Math.floor(Math.random()*255)}.${Math.floor(Math.random()*255)}.XXX.XXX</p>
                                <p>${isTimeout ? 'Perangkat ini telah terlalu lama diam. Akses Anda ke web ini telah expired.' : (isInternalError ? 'Gagal melakukan sinkronisasi dengan Cloud-Database SMAN 4. Terdeteksi gangguan pada jabat tangan (handshake) server.' : 'Perangkat ini telah tercatat memberikan suara. Akses masuk kembali diblokir oleh sistem keamanan Cloud-Database SMAN 4 Banjarmasin.')}</p>
                                <p style="margin-top:20px; font-weight:bold; color:${color2};">${isTimeout ? 'PERINGATAN: Sesi Anda habis karena aktivitas mencurigakan.' : (isInternalError ? 'TINDAKAN: Periksa koneksi internet atau hubungi Admin IT OSIS.' : 'Mencoba memanipulasi identitas perangkat dapat menyebabkan diskualifikasi suara.')}</p>
                            </div>
                            <hr style="margin-top:50px; border:0; border-top:1px solid #ccc;">
                            <footer style="font-size:0.8rem; color:#888;">Nginx/1.18.0 (Ubuntu) - Managed by IT OSIS SMAN 4</footer>
                        </div>
                    `)
